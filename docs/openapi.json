{
  "openapi": "3.1.0",
  "info": {
    "title": "LeadScout Agent API",
    "version": "5.1.0",
    "description": "Local-first multi-source lead discovery, verification, enrichment, Lighthouse-capable auditing, CRM lifecycle, separate Facebook/Instagram OAuth, Meta messaging, REST agent API and MCP."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8787"
    }
  ],
  "paths": {
    "/api/v1/health": {
      "get": {
        "summary": "Health and capabilities",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/categories": {
      "get": {
        "summary": "List supported business categories",
        "responses": {
          "200": {
            "description": "Categories"
          }
        }
      }
    },
    "/api/v1/search": {
      "post": {
        "summary": "Search OSM + Overture and merge/dedupe results",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "city",
                  "category"
                ],
                "properties": {
                  "country": {
                    "type": "string"
                  },
                  "city": {
                    "type": "string"
                  },
                  "category": {
                    "type": "string"
                  },
                  "radius_km": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100
                  },
                  "max_results": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "providers": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "osm",
                        "overture"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Search result including search_id, provider summary, partial flag and warnings"
          }
        }
      }
    },
    "/api/v1/leads": {
      "get": {
        "summary": "List/filter stored leads",
        "parameters": [
          {
            "name": "search_id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "website_status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "pipeline_status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "engagement_status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "min_score",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "has_social",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            }
          },
          {
            "name": "contactable",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lead list"
          }
        }
      }
    },
    "/api/v1/leads/{lead_id}": {
      "get": {
        "summary": "Get one lead",
        "parameters": [
          {
            "name": "lead_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lead"
          }
        }
      }
    },
    "/api/v1/leads/{lead_id}/verify": {
      "post": {
        "summary": "Cross-check a lead against Overture Places",
        "responses": {
          "200": {
            "description": "Verification result"
          }
        }
      }
    },
    "/api/v1/leads/{lead_id}/enrich": {
      "post": {
        "summary": "Crawl public business pages for email, phone, social and booking links",
        "responses": {
          "200": {
            "description": "Enriched lead"
          }
        }
      }
    },
    "/api/v1/leads/{lead_id}/audit": {
      "post": {
        "summary": "Audit website using Lighthouse when available plus heuristic checks",
        "responses": {
          "200": {
            "description": "Audit result"
          }
        }
      }
    },
    "/api/v1/leads/{lead_id}/message": {
      "get": {
        "summary": "Draft multilingual outreach",
        "parameters": [
          {
            "name": "lang",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "en",
                "tr",
                "ur",
                "sd",
                "de"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Draft"
          }
        }
      }
    },
    "/api/v1/leads/{lead_id}/status": {
      "post": {
        "summary": "Update sales pipeline stage",
        "responses": {
          "200": {
            "description": "Updated lead"
          }
        }
      }
    },
    "/api/v1/leads/{lead_id}/engagement": {
      "post": {
        "summary": "Record outreach result: drafted/sent/delivered/replied/rejected/bounced/no_response",
        "responses": {
          "200": {
            "description": "Updated lead"
          }
        }
      }
    },
    "/api/v1/leads/{lead_id}/follow-up": {
      "post": {
        "summary": "Schedule or clear follow-up",
        "responses": {
          "200": {
            "description": "Updated lead"
          }
        }
      }
    },
    "/api/v1/leads/{lead_id}/notes": {
      "post": {
        "summary": "Add CRM note",
        "responses": {
          "200": {
            "description": "Activity"
          }
        }
      }
    },
    "/api/v1/leads/{lead_id}/activities": {
      "get": {
        "summary": "List full CRM activity timeline",
        "responses": {
          "200": {
            "description": "Timeline"
          }
        }
      }
    },
    "/api/v1/leads/{lead_id}/send": {
      "post": {
        "summary": "Send through connected Facebook/Instagram account when an eligible recipient ID exists",
        "responses": {
          "200": {
            "description": "Send result"
          }
        }
      }
    },
    "/api/v1/oauth/connections": {
      "get": {
        "summary": "List connected Facebook Page / Instagram Business accounts",
        "responses": {
          "200": {
            "description": "Connections"
          }
        }
      }
    },
    "/api/v1/agent/run": {
      "post": {
        "summary": "Run autonomous search -> verify -> audit/enrich -> draft -> Excel workflow",
        "responses": {
          "200": {
            "description": "Completed agent job"
          }
        }
      }
    },
    "/api/v1/agent/jobs/{job_id}": {
      "get": {
        "summary": "Inspect stored agent job",
        "responses": {
          "200": {
            "description": "Job"
          }
        }
      }
    },
    "/api/v1/export.xlsx": {
      "get": {
        "summary": "Export filtered leads as Excel",
        "responses": {
          "200": {
            "description": "XLSX"
          }
        }
      }
    },
    "/api/v1/export.csv": {
      "get": {
        "summary": "Export filtered leads as CSV",
        "responses": {
          "200": {
            "description": "CSV"
          }
        }
      }
    },
    "/api/v1/clear": {
      "post": {
        "summary": "Clear local lead/search/CRM data; body confirm=true required",
        "responses": {
          "200": {
            "description": "Cleared"
          }
        }
      }
    },
    "/api/v1/oauth/meta/facebook/start": {
      "get": {
        "summary": "Start Facebook Login for Messenger/Page access",
        "responses": {
          "302": {
            "description": "Redirect to Facebook OAuth"
          }
        }
      }
    },
    "/api/v1/oauth/meta/instagram/start": {
      "get": {
        "summary": "Start Instagram Login for a professional account",
        "responses": {
          "302": {
            "description": "Redirect to Instagram OAuth"
          }
        }
      }
    },
    "/api/v1/oauth/meta/facebook/callback": {
      "get": {
        "summary": "Facebook OAuth callback",
        "responses": {
          "302": {
            "description": "Redirect to UI"
          }
        }
      }
    },
    "/api/v1/oauth/meta/instagram/callback": {
      "get": {
        "summary": "Instagram OAuth callback",
        "responses": {
          "302": {
            "description": "Redirect to UI"
          }
        }
      }
    },
    "/api/v1/webhooks/meta": {
      "get": {
        "summary": "Meta webhook verification handshake",
        "parameters": [
          {
            "name": "provider",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "facebook",
                "instagram"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "hub.challenge"
          }
        }
      },
      "post": {
        "summary": "Receive signed Meta messaging webhook events",
        "parameters": [
          {
            "name": "provider",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "facebook",
                "instagram"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Processed"
          },
          "401": {
            "description": "Invalid X-Hub-Signature-256"
          }
        }
      }
    },
    "/api/v1/leads/{lead_id}/messaging-eligibility": {
      "get": {
        "summary": "Check if a lead has an eligible Meta recipient id",
        "parameters": [
          {
            "name": "lead_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "provider",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "facebook",
                "instagram"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Eligibility"
          }
        }
      }
    },
    "/api/v1/leads/{lead_id}/messaging-recipient": {
      "post": {
        "summary": "Associate an eligible Meta recipient/conversation id with a lead",
        "parameters": [
          {
            "name": "lead_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "provider",
                  "recipient_id"
                ],
                "properties": {
                  "provider": {
                    "type": "string",
                    "enum": [
                      "facebook",
                      "instagram"
                    ]
                  },
                  "recipient_id": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Linked"
          }
        }
      }
    },
    "/api/v1/crm/refresh-no-response": {
      "post": {
        "summary": "Mark stale sent/delivered leads with no reply as no_response",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "days": {
                    "type": "integer",
                    "default": 7
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated leads"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Optional. Set LEADSCOUT_API_TOKEN to protect /api/v1 endpoints."
      }
    }
  }
}
