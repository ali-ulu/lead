LEADSCOUT_HOST=127.0.0.1
LEADSCOUT_PORT=8787

# Optional: require Authorization: Bearer <token> on /api/v1/*
# LEADSCOUT_API_TOKEN=change-me

# Overture Places
# Latest release is discovered automatically. Override only if needed.
# OVERTURE_RELEASE=2026-08-19.0
# OVERTURE_PLACES_GLOB=s3://overturemaps-us-west-2/release/2026-08-19.0/theme=places/type=place/*

# Meta Graph API version. Leave blank to use Meta's unversioned endpoint,
# or set the version configured/tested in your Meta app (for example v26.0).
# META_GRAPH_VERSION=v26.0
# META_INSTAGRAM_GRAPH_VERSION=v26.0

# Facebook Login / Messenger
# META_APP_ID=
# META_APP_SECRET=
# META_FACEBOOK_REDIRECT_URI=http://127.0.0.1:8787/api/v1/oauth/meta/facebook/callback
# META_FACEBOOK_SCOPES=pages_show_list,pages_messaging,pages_manage_metadata,pages_read_engagement

# Instagram Login for professional Business/Creator accounts.
# You may use the same Meta app credentials, or a dedicated Instagram app id/secret.
# META_INSTAGRAM_APP_ID=
# META_INSTAGRAM_APP_SECRET=
# META_INSTAGRAM_REDIRECT_URI=http://127.0.0.1:8787/api/v1/oauth/meta/instagram/callback
# META_INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_manage_messages

# Meta webhook
# Public production webhook must be HTTPS:
#   https://YOUR_DOMAIN/api/v1/webhooks/meta?provider=facebook
#   https://YOUR_DOMAIN/api/v1/webhooks/meta?provider=instagram
# META_WEBHOOK_VERIFY_TOKEN=choose-a-random-string
# Incoming POSTs are rejected unless X-Hub-Signature-256 validates.
# Only for local tests, never production:
# LEADSCOUT_META_ALLOW_UNSIGNED_WEBHOOK=0

# Optional explicit Fernet key for encrypted OAuth tokens.
# If omitted, LeadScout creates data/token.key locally.
# LEADSCOUT_TOKEN_KEY=

# MCP permissions.
# CRM writes are enabled by default for local/self-use.
# LEADSCOUT_MCP_ALLOW_WRITE=1
# Sending and destructive clear are opt-in.
# LEADSCOUT_MCP_ALLOW_SEND=0
# LEADSCOUT_MCP_ALLOW_CLEAR=0

# Agent send gate. Drafting/auditing works without it.
# LEADSCOUT_AGENT_SEND=0

# Optional Lighthouse CLI path. If blank, LeadScout checks PATH and node_modules/.bin.
# LEADSCOUT_LIGHTHOUSE_BIN=lighthouse
