LEADSCOUT_HOST=127.0.0.1
LEADSCOUT_PORT=8787

# Optional: require Authorization: Bearer <token> on /api/v1/*
# LEADSCOUT_API_TOKEN=change-me

# Overture Places
# Latest release is discovered from STAC automatically. Override only if needed.
# OVERTURE_RELEASE=2026-08-19.0
# OVERTURE_PLACES_GLOB=s3://overturemaps-us-west-2/release/2026-08-19.0/theme=places/type=place/*

# Meta OAuth / Messaging
# Create a Meta app and register META_REDIRECT_URI as an OAuth redirect URL.
# META_APP_ID=
# META_APP_SECRET=
# META_GRAPH_VERSION=
# META_REDIRECT_URI=http://127.0.0.1:8787/api/v1/oauth/meta/callback
# META_SCOPES=pages_show_list,pages_messaging,pages_manage_metadata,instagram_basic,instagram_manage_messages
# META_WEBHOOK_VERIFY_TOKEN=choose-a-random-string

# Optional explicit Fernet key for encrypted OAuth tokens.
# If omitted, LeadScout creates data/token.key locally.
# LEADSCOUT_TOKEN_KEY=

# Agent send gates. Drafting/auditing works without these.
# LEADSCOUT_AGENT_SEND=0
# LEADSCOUT_MCP_ALLOW_SEND=0

# Optional Lighthouse CLI path. If blank, LeadScout checks PATH.
# LEADSCOUT_LIGHTHOUSE_BIN=lighthouse
